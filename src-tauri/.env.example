# 智谱 AI 开放平台 API Key（注册/领取：https://bigmodel.cn/console/apikeys）
# 用法：复制本文件为同目录下的 .env，填入你的 key。.env 不提交仓库、不硬编码。
# 把 .env 放在 exe 同目录（或 src-tauri/ 下）即可，程序启动时会自动读取。
ZHIPU_API_KEY=your_key_here

# 以下两项可选，留空则使用默认值。
# 多模态视觉模型（看图理解 / 搜题），默认 glm-4v-flash（免费）
ZHIPU_VISION_MODEL=glm-4v-flash
# 画图模型，默认 glm-4-flash
ZHIPU_DRAW_MODEL=glm-4-flash
