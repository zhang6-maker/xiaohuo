{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xiaohuo",
  "version": "0.0.9",
  "identifier": "io.github.zhang6maker.xiaohuo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "小火",
        "width": 480,
        "height": 540,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
    "resizable": true,
    "shadow": false,
    "center": false
  }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
    "bundle": {
      "active": true,
      "targets": ["msi"]
    }
}
